# ═══════════════════════════════════════════════════════════════════════════════
# Environmental Platform — Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to .env and adjust values for your environment.
# Docker Compose uses these values automatically.

# ═══ Security ═══
JWT_SECRET=dev-secret-change-in-production-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ═══ Database (PostgreSQL) ═══
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/environmental
# For Docker: postgresql+asyncpg://postgres:postgres@postgres:5432/environmental

# ═══ Cache (Redis) ═══
REDIS_URL=redis://localhost:6379/0
# For Docker: redis://redis:6379/0

# ═══ Search (Elasticsearch) ═══
ELASTICSEARCH_URL=http://localhost:9200
# For Docker: http://elasticsearch:9200

# ═══ Object Storage (MinIO / S3-compatible) ═══
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=environmental-reports
MINIO_SECURE=false
# For Docker: MINIO_ENDPOINT=minio:9000

# ═══ Upload ═══
UPLOAD_DIR=/tmp/environmental_uploads
MAX_UPLOAD_SIZE_MB=50

# ═══ Crawler ═══
CRAWLER_CACHE_DIR=/tmp/environmental_crawler_cache
CRAWLER_DOWNLOAD_DELAY=0.5
CRAWLER_CONCURRENT_REQUESTS=8

# ═══ AI/ML ═══
# DeepSeek (for AI features)
DEEPSEEK_API_KEY=sk-553972cbb04943c48ff916277f60bf06
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ═══ Observability ═══
LOG_LEVEL=INFO
SENTRY_DSN=

# ═══ App Metadata ═══
APP_NAME=Environmental Reports Platform
APP_VERSION=0.2.0
APP_ENV=development
DEBUG=false
